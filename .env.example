# Copy this file to `.env.local` and fill in the values.
# These are PUBLIC values (they end up in the browser bundle). Never put secret keys here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# "/" for local dev and the custom domain (magicianhelper.com)
VITE_BASE_PATH=/

# Price shown on the landing page and billing page (the real price lives in Stripe)
VITE_PRICE_LABEL=€9.99/month

# Public address of the site, used for canonical links, Open Graph and the sitemap
# (defaults to https://magicianhelper.com/)
# VITE_SITE_URL=https://www.example.com/

# Google Search Console → Add property → "HTML tag" method: the content="…" value
# VITE_GOOGLE_SITE_VERIFICATION=
